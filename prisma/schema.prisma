model ProductPackItem {
  id            Int         @id @default(autoincrement())
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  packId        Int
  pack          Pack        @relation("PackItems", fields: [packId], references: [id])
  quantity      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
  @@index([packId])
}

// Supplier model for supply management
model Supplier {
  id                Int               @id @default(autoincrement())
  name              String
  email             String?
  phone             String?
  address           String?
  city              String?
  state             String?
  zipCode           String?
  isActive          Boolean           @default(true)
  purchaseOrders    PurchaseOrder[]
  purchaseInvoices  PurchaseInvoice[]
  inbounds          Inbound[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([name])
  @@index([email])
  @@index([phone])
}

// Purchase Order model for ordering from suppliers
model PurchaseOrder {
  id             Int           @id @default(autoincrement())
  orderNumber    String        @unique
  supplierId     Int
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  status         POStatus      @default(DRAFT)
  totalAmount    Decimal       @db.Decimal(10, 2)
  notes          String?       @db.Text
  createdBy      String        // کاربر ایجادکننده
  createdByUser  User         @relation("CreatedPurchaseOrders", fields: [createdBy], references: [id])
  approvedBy     String?       // کاربر تایید کننده
  approvedByUser User?        @relation("ApprovedPurchaseOrders", fields: [approvedBy], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdBy])
  @@index([approvedBy])
  @@index([createdAt])
}

// Purchase Order Item for individual products in a purchase order
model PurchaseOrderItem {
  id             Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId      Int
  product        Product       @relation(fields: [productId], references: [id])
  quantity       Int
  price          Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

// Purchase Invoice model for supplier invoices
model PurchaseInvoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  supplierId     Int
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  status         PIStatus      @default(DRAFT)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @db.Decimal(10, 2) @default(0)
  notes          String?       @db.Text
  createdBy      String        // کاربر ایجادکننده
  createdByUser  User         @relation("CreatedPurchaseInvoices", fields: [createdBy], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          PurchaseInvoiceItem[]

  @@index([supplierId])
  @@index([status])
  @@index([createdBy])
  @@index([createdAt])
}

// Purchase Invoice Item for individual products in a purchase invoice
model PurchaseInvoiceItem {
  id                Int            @id @default(autoincrement())
  purchaseInvoiceId Int
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  productId         Int
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  price             Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([purchaseInvoiceId])
  @@index([productId])
}

enum POStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
}

enum PIStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Pack {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String          @unique
  description String?         @db.Text
  items       ProductPackItem[] @relation("PackItems")
  invoiceItems InvoiceItem[]  @relation("PackInvoiceItems")
  outboundItems OutboundItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([name])
  @@index([createdAt])
}

// Inbound model for incoming goods/purchases
model Inbound {
  id             Int      @id @default(autoincrement())
  invoiceNumber  String   @unique // شماره فاکتور (اتومات)
  productTitle   String   // عنوان محصول
  supplierId     Int?     // تامین کننده
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  supplierName   String?  // نام تامین کننده (در صورت عدم وجود در سیستم)
  supplierPhone  String?  // شماره تامین کننده
  supplierAddress String? @db.Text // آدرس تامین کننده
  date           DateTime // تاریخ
  quantity       Int      // تعداد
  totalPrice     Decimal  @db.Decimal(10, 2) // قیمت کلی فاکتور
  unitPrice      Decimal  @db.Decimal(10, 2) // قیمت واحد (محاسبه شده)
  createdBy      String   // کاربر ایجادکننده
  createdByUser  User     @relation("CreatedInbounds", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([createdBy])
  @@index([date])
  @@index([createdAt])
}

// Outbound model for outgoing goods/sales
model Outbound {
  id               Int              @id @default(autoincrement())
  invoiceCode      String           @unique // کد فاکتور
  status           OutboundStatus   @default(OPEN) // وضعیت فاکتور
  orderDate        DateTime         // تاریخ سفارش
  deliveryDate     DateTime         // تاریخ تحویل (لیمیت تایم)
  customerName     String           // سفارش دهنده
  customerPhone    String?          // شماره سفارش دهنده
  settlementPeriod SettlementPeriod @default(CASH) // دوره تسویه
  customerOrder    String           // سفارش مشتری
  productDescription String         @db.Text // شرح کالا
  items            OutboundItem[]   // آیتم‌های فاکتور
  totalQuantity    Int              // تعداد کل کالاها
  purchaseAmount   Decimal          @db.Decimal(10, 2) // مبلغ خرید
  marginPercent    Int              // درصد مارژین
  salesAmount      Decimal          @db.Decimal(10, 2) // مبلغ فروش
  createdBy        String           // کاربر ایجادکننده (مدیر فروش)
  createdByUser    User             @relation("CreatedOutbounds", fields: [createdBy], references: [id])
  approvedBy       String?          // تایید کننده (مدیر مالی)
  approvedByUser   User?            @relation("ApprovedOutbounds", fields: [approvedBy], references: [id])
  shippedBy        String?          // ارسال کننده (مدیر انبار)
  shippedByUser    User?            @relation("ShippedOutbounds", fields: [shippedBy], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([invoiceCode])
  @@index([status])
  @@index([orderDate])
  @@index([deliveryDate])
  @@index([createdBy])
  @@index([approvedBy])
  @@index([shippedBy])
  @@index([createdAt])
}

// Outbound items for detailed product listing
model OutboundItem {
  id          Int       @id @default(autoincrement())
  outboundId  Int
  outbound    Outbound  @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id])
  packId      Int?
  pack        Pack?     @relation(fields: [packId], references: [id])
  productName String    // نام محصول (در صورت عدم وجود در سیستم)
  quantity    Int       // تعداد
  unitPrice   Decimal   @db.Decimal(10, 2) // قیمت واحد
  totalPrice  Decimal   @db.Decimal(10, 2) // قیمت کل
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([outboundId])
  @@index([productId])
  @@index([packId])
}

enum OutboundStatus {
  OPEN          // باز - مدیر فروش قرار داده ولی مالی تایید نکرده
  IN_TRANSIT    // درحال ارسال - مالی تایید کرده و در بررسی انبار
  SHIPPED       // ارسال شده - انبار ارسال کرده
}

enum SettlementPeriod {
  CASH          // نقدی
  ONE_MONTH     // یک ماهه
  TWO_MONTHS    // دو ماهه
  THREE_MONTHS  // سه ماهه
}

// Discount Code model for logarithmic discount system
model DiscountCode {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  percentage  Int      // درصد تخفیف
  minPurchase Int      // حداقل مبلغ خرید
  maxDiscount Int      // حداکثر مبلغ تخفیف
  isActive    Boolean  @default(true)
  isUsed      Boolean  @default(false)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("discount_codes")
  @@index([userId])
  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

// Purchase Comments model for post-purchase feedback
model PurchaseComment {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      // امتیاز 1-5
  comment     String   @db.Text // نظر مشتری
  isPublic    Boolean  @default(false) // آیا عمومی باشد؟
  isApproved  Boolean  @default(false) // تایید شده توسط ادمین
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("purchase_comments")
  @@index([orderId])
  @@index([userId])
  @@index([rating])
  @@index([isApproved])
}

// System settings for storing configuration
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// User Pack model for regular user customization
model UserPack {
  id          Int               @id @default(autoincrement())
  name        String            // نام پک
  description String?           @db.Text // توضیحات
  userId      String            // کاربر سازنده
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic    Boolean           @default(false) // آیا عمومی است؟
  isActive    Boolean           @default(true)
  items       UserPackItem[]    // آیتم‌های پک
  orders      UserPackOrder[]   // سفارشات این پک
  cartItems   CartItem[]        // آیتم‌های سبد خرید
  orderItems  OrderItem[]       // آیتم‌های سفارش
  totalPrice  Decimal?          @db.Decimal(10, 2) // قیمت کل محاسبه شده
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([isPublic])
  @@index([name])
}

// User Pack Items
model UserPackItem {
  id            Int        @id @default(autoincrement())
  userPackId    Int
  userPack      UserPack   @relation(fields: [userPackId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product    @relation(fields: [productId], references: [id])
  quantity      Int        // تعداد مورد نیاز
  notes         String?    // یادداشت‌های خاص
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userPackId])
  @@index([productId])
}

// User Pack Orders for tracking user pack purchases
model UserPackOrder {
  id            String          @id @default(cuid())
  orderNumber   String          @unique // شماره سفارش
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  userPackId    Int?            // پک شخصی‌سازی شده (اختیاری)
  userPack      UserPack?       @relation(fields: [userPackId], references: [id])
  status        OrderStatus     @default(PENDING)
  totalAmount   Decimal         @db.Decimal(10, 2)
  notes         String?         @db.Text
  items         UserPackOrderItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([userPackId])
  @@index([status])
  @@index([orderNumber])
}

// User Pack Order Items
model UserPackOrderItem {
  id                Int             @id @default(autoincrement())
  userPackOrderId   String
  userPackOrder     UserPackOrder   @relation(fields: [userPackOrderId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  totalPrice        Decimal         @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userPackOrderId])
  @@index([productId])
}

// Product Request model for customers to request unavailable products
model ProductRequest {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation("UserProductRequests", fields: [userId], references: [id], onDelete: Cascade)
  productName String
  description String?  @db.Text
  quantity    Int      @default(1)
  priority    RequestPriority @default(NORMAL)
  status      RequestStatus @default(PENDING)
  adminNotes  String?  @db.Text
  adminId     String?  // Admin who processed the request
  admin       User?    @relation("AdminProductRequests", fields: [adminId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

// Debt model for tracking customer debts
model Debt {
  id              Int             @id @default(autoincrement())
  customerId      String          // شناسه مشتری
  customer        User            @relation("CustomerDebts", fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId       Int?            // شناسه فاکتور مرتبط (اختیاری)
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id])
  orderId         String?         // شناسه سفارش مرتبط (اختیاری)
  order           Order?          @relation(fields: [orderId], references: [id])
  amount          Decimal         @db.Decimal(10, 2) // مبلغ بدهی
  paidAmount      Decimal         @db.Decimal(10, 2) @default(0) // مبلغ پرداخت شده
  remainingAmount Decimal         @db.Decimal(10, 2) // مبلغ باقی‌مانده
  settlementType  SettlementPeriod // نوع تسویه (نقدی، یک ماهه، دو ماهه، سه ماهه)
  dueDate         DateTime        // تاریخ سررسید
  status          DebtStatus      @default(PENDING) // وضعیت بدهی
  description     String?         @db.Text // توضیحات
  notes           String?         @db.Text // یادداشت‌های داخلی
  salesRepId      String?         // شناسه مسئول فروش
  salesRep        User?           @relation("SalesRepDebts", fields: [salesRepId], references: [id])
  adminId         String?         // شناسه ادمین که بدهی را ثبت کرده
  admin           User?           @relation("AdminDebts", fields: [adminId], references: [id])
  payments        DebtPayment[]   // پرداخت‌های انجام شده
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId])
  @@index([invoiceId])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
  @@index([salesRepId])
  @@index([createdAt])
}

// Debt Payment model for tracking individual payments
model DebtPayment {
  id          Int           @id @default(autoincrement())
  debtId      Int
  debt        Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2) // مبلغ پرداخت
  paymentMethod PaymentMethod // روش پرداخت
  paymentDetails String?     @db.Text // جزئیات پرداخت (شماره کارت، شماره حساب، etc.)
  adminId     String?       // شناسه ادمین که پرداخت را ثبت کرده
  admin       User?         @relation("AdminDebtPayments", fields: [adminId], references: [id])
  notes       String?       @db.Text // یادداشت‌های پرداخت
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([debtId])
  @@index([paymentMethod])
  @@index([adminId])
  @@index([createdAt])
}

enum DebtStatus {
  PENDING     // در انتظار پرداخت
  PARTIAL     // پرداخت جزئی
  PAID        // پرداخت شده
  OVERDUE     // معوق
  CANCELLED   // لغو شده
}

enum PaymentMethod {
  CASH        // نقدی
  CARD        // کارت بانکی
  BANK_TRANSFER // انتقال بانکی
  CHECK       // چک
  OTHER       // سایر
}
