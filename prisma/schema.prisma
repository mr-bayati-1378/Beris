// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Level 1 Category (Main Category)
model CategoryL1 {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  categoryL2s CategoryL2[] // Relation to Level 2 categories
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Level 2 Category
model CategoryL2 {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  categoryL1  CategoryL1   @relation(fields: [categoryL1Id], references: [id])
  categoryL1Id Int
  categoryL3s CategoryL3[] // Relation to Level 3 categories
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Level 3 Category
model CategoryL3 {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  categoryL2  CategoryL2 @relation(fields: [categoryL2Id], references: [id])
  categoryL2Id Int
  products    Product[] // Relation to products
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Product model
model Product {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  description       String?  @db.Text
  brand             String?
  price             Decimal  @db.Decimal(10, 2)
  comparePrice      Decimal? @db.Decimal(10, 2)
  image             String?
  stock             Int      @default(0)
  isActive          Boolean  @default(true)
  isVipOnly         Boolean  @default(false) // محصولات اختصاصی برای مشتریان VIP
  hasDiscount       Boolean  @default(false)
  discountPercent   Int?
  discountStartDate DateTime?
  discountEndDate   DateTime?
  averageRating     Float?   @default(0)
  categoryL3Id      Int
  categoryL3        CategoryL3 @relation(fields: [categoryL3Id], references: [id])
  images        ProductImage[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  ratings       ProductRating[]
  reviews       ProductReview[]
  stockAlerts   StockAlert[]
  favorites     Favorite[]
  tags          ProductTag[]
  invoiceItems  InvoiceItem[]
  packItems     ProductPackItem[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  outboundItems OutboundItem[]
  userPackItems UserPackItem[]
  userPackOrderItems UserPackOrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryL3Id])
  @@index([name])
  @@index([createdAt])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isMain    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductTag {
  id        Int      @id @default(autoincrement())
  name      String
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductRating {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    String
  rating    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

model ProductReview {
  id           Int           @id @default(autoincrement())
  productId    Int
  userId       String
  rating       Int
  title        String
  content      String        @db.Text
  comment      String?       @db.Text
  status       ReviewStatus  @default(PENDING)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes        ReviewVote[]
  replies      ReviewReply[]
  helpfulCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ReviewVote {
  id       Int      @id @default(autoincrement())
  reviewId Int
  userId   String
  voteType String   // 'helpful' or 'unhelpful'
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model ReviewReply {
  id       Int      @id @default(autoincrement())
  reviewId Int
  userId   String
  content  String   @db.Text
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@index([userId])
  @@index([createdAt])
}

// User model
model User {
  id                String    @id @default(cuid())
  email             String?   @unique
  username          String?   @unique
  firstName         String?
  lastName          String?
  profileImage      String?   // Profile picture path
  nationalCode      String?   @unique
  phoneNumber       String?   @unique
  phoneVerified     Boolean   @default(false)
  isProfileComplete Boolean   @default(false)
  latitude          Float?
  longitude         Float?
  password          String    // Hashed password
  phone             String    @unique
  emailVerified     Boolean   @default(false)
  isActive          Boolean   @default(true)
  isVip             Boolean   @default(false) // مشتری VIP - دسترسی به محصولات اختصاصی
  cart              Cart?
  favorites         Favorite[]
  addresses         Address[]
  orders            Order[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  preferences       UserPreference?
  notifications     Notification[]
  // stockAlerts       StockAlert[] // حذف شده چون StockAlert دیگر به User مرتبط نیست
  isAdmin           Boolean   @default(false)
  adminRole         AdminRole? @relation(fields: [adminRoleId], references: [id])
  adminRoleId       Int?
  wishlist          Wishlist?
  ratings           ProductRating[]
  reviews           ProductReview[]
  reviewVotes       ReviewVote[]
  reviewReplies     ReviewReply[]
  adminActivities   AdminActivity[]
  customerInvoices  Invoice[] @relation("CustomerInvoices")
  createdInvoices   Invoice[] @relation("CreatedInvoices")
  createdPaymentDocuments PaymentDocument[] @relation("CreatedPaymentDocuments")
  createdPurchaseOrders PurchaseOrder[] @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders PurchaseOrder[] @relation("ApprovedPurchaseOrders")
  createdPurchaseInvoices PurchaseInvoice[] @relation("CreatedPurchaseInvoices")
  createdInbounds       Inbound[] @relation("CreatedInbounds")
  createdOutbounds      Outbound[] @relation("CreatedOutbounds")
  approvedOutbounds     Outbound[] @relation("ApprovedOutbounds")
  shippedOutbounds      Outbound[] @relation("ShippedOutbounds")
  discountCodes         DiscountCode[]
  purchaseComments      PurchaseComment[]
  userPacks             UserPack[]
  userPackOrders        UserPackOrder[]
  productRequests       ProductRequest[] @relation("UserProductRequests")
  adminProductRequests ProductRequest[] @relation("AdminProductRequests")
  debts                 Debt[] @relation("AdminDebts")
  salesRepDebts         Debt[] @relation("SalesRepDebts")
  debtPayments          DebtPayment[] @relation("AdminDebtPayments")
  customerDebts         Debt[] @relation("CustomerDebts")
}

// Shopping Cart
model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

// Cart Item
model CartItem {
  id        Int       @id @default(autoincrement())
  cartId    Int
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int?      // اختیاری - برای محصولات عادی
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userPackId Int?     // اختیاری - برای پک‌های کاربری
  userPack  UserPack? @relation(fields: [userPackId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([userPackId])
}

// Favorite/Wishlist
model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// Address
model Address {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  address   String
  city      String
  state     String
  zipCode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Order {
  id        String    @id @default(cuid())
  slug      String    @unique
  status    OrderStatus @default(PENDING)
  total     Decimal   @db.Decimal(10, 2)
  items     OrderItem[]
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  payment   Payment?
  
  // آدرس تحویل (Shipping Address)
  deliveryAddress   String
  deliveryCity      String
  deliveryState     String
  deliveryZipCode   String
  deliveryPhone     String?
  deliveryRecipient String? // نام گیرنده
  
  // آدرس فاکتور (Billing Address) - اختیاری
  useSameAddressForBilling Boolean @default(true) // آیا از همان آدرس تحویل برای فاکتور استفاده شود
  billingAddress   String?
  billingCity      String?
  billingState     String?
  billingZipCode   String?
  billingPhone     String?
  billingRecipient String? // نام گیرنده فاکتور
  
  purchaseComment PurchaseComment?
  debts     Debt[]    // روابط بدهی
  
  // فیلدهای تایید و رد سفارش
  approvedBy String?  // ID کاربری که سفارش را تایید کرده
  approvedAt DateTime?
  rejectedBy String?  // ID کاربری که سفارش را رد کرده
  rejectedAt DateTime?
  salesRep   String?  // نام مسئول فروش
  notes      String?  @db.Text // یادداشت‌های اضافی
  
  // فیلدهای تایید مالی
  financeApprovedBy String?  // ID کاربری که تایید مالی کرده
  financeApprovedAt DateTime?
  financeRejectedBy String?  // ID کاربری که رد مالی کرده
  financeRejectedAt DateTime?
  financeNotes      String?  @db.Text // یادداشت‌های مالی
  
  // فیلدهای تایید انبار
  warehouseApprovedBy String?  // ID کاربری که تایید انبار کرده
  warehouseApprovedAt DateTime?
  warehouseRejectedBy String?  // ID کاربری که رد انبار کرده
  warehouseRejectedAt DateTime?
  warehouseNotes      String?  @db.Text // یادداشت‌های انبار
  
  // منبع سفارش
  orderSource OrderSource @default(WEBSITE) // WEBSITE یا SALES_REP
  
  // فیلدهای جدید فاکتور
  invoiceNumber    String?  // کد فاکتور
  orderDate        DateTime? // تاریخ سفارش
  deliveryDate     DateTime? // تاریخ تحویل
  settlementPeriod String?  // دوره تسویه
  salesExpert      String?  // کارشناس فروش
  salesChannel     String?  // کانال فروش
  totalPurchase    Decimal? @db.Decimal(10, 2) // مبلغ خرید
  totalGrossSale   Decimal? @db.Decimal(10, 2) // فروش ناخالص
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?     // اختیاری - برای محصولات عادی
  product   Product? @relation(fields: [productId], references: [id])
  userPackId Int?    // اختیاری - برای پک‌های کاربری
  userPack  UserPack? @relation(fields: [userPackId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  // فیلدهای جدید آیتم
  marginPercent Int?  // درصد مارژین
  grossSale     Decimal? @db.Decimal(10, 2) // فروش ناخالص
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([userPackId])
}

model StockAlert {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  type      String   // 'low_stock', 'out_of_stock', 'custom'
  message   String   @db.Text
  isResolved Boolean @default(false)
  resolvedAt DateTime?
  resolvedBy String?  // admin user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([type])
  @@index([isResolved])
  @@index([createdAt])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(true)
  marketingEmails    Boolean @default(true)
  theme            String   @default("light")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String   @db.Text
  isRead    Boolean  @default(false)
  read      Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Wishlist {
  id        Int           @id @default(autoincrement())
  userId    String        @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([wishlistId])
  @@index([productId])
}

// Phone Verification model
model PhoneVerification {
  id          Int      @id @default(autoincrement())
  phoneNumber String   @unique
  code        String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Password Reset model
model PasswordReset {
  id          Int      @id @default(autoincrement())
  phoneNumber String   
  code        String
  expiresAt   DateTime
  used        Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
}

// Payment Gateway model
model PaymentGateway {
  id          Int      @id @default(autoincrement())
  name        String   @unique // zarinpal, mellat, saman, parsian, etc.
  displayName String   // نام نمایشی
  isActive    Boolean  @default(true)
  config      Json     // تنظیمات گیت‌وی
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payments    Payment[]
}

// Payment model
model Payment {
  id             Int            @id @default(autoincrement())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayId      Int
  gateway        PaymentGateway @relation(fields: [gatewayId], references: [id])
  amount         Decimal        @db.Decimal(10, 2)
  status         String         // pending, success, failed
  transactionId  String?
  referenceId    String?
  trackingCode   String?
  paidAt         DateTime?
  gatewayResponse Json?
  failedReason   String?
  callbackUrl    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([gatewayId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING     // در انتظار پرداخت
  PROCESSING  // در حال پردازش
  PAID        // پرداخت شده
  VERIFIED    // تایید شده
  FAILED      // ناموفق
  CANCELLED   // لغو شده
  REFUNDED    // بازگشت داده شده
}

// Customer Chat model for consultation widget
model CustomerChat {
  id           Int      @id @default(autoincrement())
  customerName String
  customerPhone String
  customerEmail String? // ایمیل مشتری (اختیاری)
  message      String   @db.Text
  status       String   @default("pending") // pending, replied, closed
  source       String?  @default("chat") // chat, contact_form
  adminReply   String?  @db.Text
  repliedAt    DateTime?
  repliedBy    String?  // admin username who replied
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([source])
}

// Admin Role model for role-based access control
model AdminRole {
  id            Int      @id @default(autoincrement())
  name          String   @unique // sales, supply, warehouse, finance, admin
  displayName   String   // نام نمایشی فارسی
  permissions   Json     // آرایه‌ای از مجوزها
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]   // کاربران با این نقش
}

// Activity Log model for tracking admin actions
model AdminActivity {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // create, update, delete, view
  entityType  String   // product, order, user, etc.
  entityId    String
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// Invoice model for sales management
model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique
  customerId     String?
  customer       User?         @relation("CustomerInvoices", fields: [customerId], references: [id])
  status         InvoiceStatus @default(OPEN)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @db.Decimal(10, 2) @default(0)
  dueDate        DateTime?
  paymentDate    DateTime?
  notes          String?       @db.Text
  createdById    String
  createdBy      User         @relation("CreatedInvoices", fields: [createdById], references: [id])
  items          InvoiceItem[]
  paymentDocuments PaymentDocument[] // مستندات پرداخت
  debts          Debt[]        // روابط بدهی
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

// Payment Document model for tracking payment documents
model PaymentDocument {
  id            Int           @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type          String        // check, bank_transfer, cash
  amount        Decimal       @db.Decimal(10, 2)
  date          DateTime
  checkNumber   String?       // شماره چک
  checkDate     DateTime?     // تاریخ چک
  accountNumber String?       // شماره حساب
  bankName      String?       // نام بانک
  notes         String?       @db.Text // یادداشت
  createdBy     String        // کاربر ایجادکننده
  createdByUser User          @relation("CreatedPaymentDocuments", fields: [createdBy], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([invoiceId])
  @@index([type])
  @@index([date])
  @@index([createdBy])
  @@index([createdAt])
}

model InvoiceItem {
  id            Int         @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice     @relation(fields: [invoiceId], references: [id])
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  packId        Int?
  pack          Pack?       @relation("PackInvoiceItems", fields: [packId], references: [id])
  quantity      Int
  price         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([invoiceId])
  @@index([productId])
  @@index([packId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderSource {
  WEBSITE
  SALES_REP
}

enum OrderStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PENDING_FINANCE_APPROVAL
  FINANCE_APPROVED
  PENDING_WAREHOUSE_APPROVAL
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  OPEN
  PAID
  CANCELLED
  OVERDUE
}

