# 🚀 فایل تنظیمات محیط پروژه بریس
# این فایل را کپی کرده و به نام .env ذخیره کنید
# سپس مقادیر را طبق سیستم خود تغییر دهید

# 🗄️ دیتابیس MySQL
DATABASE_URL="mysql://beris_user:beris_password@localhost:3306/beris"

# 🔐 کلیدهای امنیتی
AUTH_SECRET="your-super-secret-auth-key-here-change-it-in-production"
NEXTAUTH_SECRET="your-secret-key-beris-2024"

# 🌐 آدرس سایت
NEXTAUTH_URL="http://localhost:3000"

# برای production:
# NEXTAUTH_URL="https://yourdomain.com"

# 📱 پیامک (اختیاری)
# KAVENEGAR_API_KEY="your-kavenegar-api-key"

# 💳 درگاه پرداخت (اختیاری)
# ZARINPAL_MERCHANT_ID="your-zarinpal-merchant-id"

# 🔍 جستجو (اختیاری)
# TYPESENSE_API_KEY="your-typesense-api-key"
# TYPESENSE_HOST="localhost"
# TYPESENSE_PORT="8108"

# 📧 ایمیل (اختیاری)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# 🚀 حالت اجرا
NODE_ENV="development"

# 📊 تحلیل و آمار (اختیاری)
# GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"

# ☁️ ذخیره‌سازی فایل (اختیاری)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# 🔧 دیباگ
DEBUG="false" 