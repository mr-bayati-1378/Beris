{
  "name": "beris",
  "version": "0.1.0",
  "private": true,
  "description": "Modern e-commerce platform built with Next.js, TypeScript, and Prisma",
  "keywords": [
    "nextjs",
    "typescript",
    "ecommerce",
    "prisma",
    "tailwindcss",
    "react"
  ],
  "author": "Beris Team",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:network": "HOST=0.0.0.0 next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --compiler-options='{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "seed:products": "node prisma/seed-products.js",
    "seed:admins": "node prisma/seed-real-admins.js",
    "seed:all": "npm run seed:products && npm run seed:admins",
    "db:reset": "prisma migrate reset && prisma db seed",
    "db:setup": "npx prisma generate && npx prisma db push",
    "test:quick": "./quick-test.sh",
    "setup:env": "cp env.example .env",
    "clean": "rm -rf .next out dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.0",
    "googleapis": "^153.0.0",
    "jose": "^6.0.11",
    "jsonwebtoken": "^9.0.2",
    "kavenegar": "^1.1.4",
    "lucide-react": "^0.515.0",
    "moment-jalaali": "^0.10.4",
    "mysql2": "^3.14.1",
    "nanoid": "^5.1.5",
    "next": "^14.2.30",
    "next-auth": "^5.0.0-beta.28",
    "node-fetch": "^3.3.2",
    "prisma": "^6.9.0",
    "react": "^18",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.2",
    "sonner": "^2.0.5",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-rtl": "^0.9.0",
    "typesense": "^2.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.19.8",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.14",
    "eslint": "^8",
    "eslint-config-next": "14.1.3",
    "postcss": "^8.4.31",
    "prettier": "^3.6.1",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/beris.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/beris/issues"
  },
  "homepage": "https://github.com/your-username/beris#readme"
}
